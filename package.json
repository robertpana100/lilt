{
  "name": "lilt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A little room for endless music. Procedural composition and instrument synthesis, on your device.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@happy-dom/global-registrator": "20.11.2",
    "@testing-library/react": "16.3.2",
    "@types/react-dom": "19.2.4",
    "react-dom": "19.2.8",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
